# 此文件仅配置非敏感选项。不要在这里填写 API Key。
# 免安装版使用“配置模型”；源码版使用 pnpm credentials:setup。
# 原有 .env.local 凭据可用 node scripts/credentials.mjs --import-env 安全迁移。
DATABASE_URL=data/app.db
APP_BASE_URL=http://127.0.0.1:3000
MOCK_AI=0
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODELS=
SEARCH_PROVIDER=deepseek
# 本机跨身份共用上限，包含未完成请求预占；0 表示禁止。
LDC_DAILY_MODEL_LIMIT=80
LDC_DAILY_SEARCH_LIMIT=40
LDC_MAX_EXTERNAL_CONCURRENCY=2
# 默认只信任官方 API。使用代理即把 Key 交给代理，需自行确认可信性。
LDC_ALLOW_CUSTOM_API=0
LDC_TRUSTED_API_ORIGINS=
